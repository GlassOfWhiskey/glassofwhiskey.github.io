{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV",
  "type": "object",
  "required": [
    "personal", "experience", "awards", "education", "research",
    "projects", "conferences", "software", "editorial", "review", "teaching"
  ],
  "additionalProperties": false,
  "properties": {
    "personal": {
      "type": "object",
      "required": [
        "first", "last", "address1", "address2", "email", "homepage",
        "github", "orcid", "googlescholar", "photo", "photo_height",
        "photo_frame", "bio"
      ],
      "additionalProperties": false,
      "properties": {
        "first":         { "type": "string", "minLength": 1 },
        "last":          { "type": "string", "minLength": 1 },
        "address1":      { "type": "string", "minLength": 1 },
        "address2":      { "type": "string", "minLength": 1 },
        "email":         { "type": "string", "minLength": 1 },
        "homepage":      { "type": "string", "minLength": 1 },
        "github":        { "type": "string", "minLength": 1 },
        "orcid":         { "type": "string", "minLength": 1, "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$" },
        "googlescholar": { "type": "string", "minLength": 1 },
        "linkedin":      { "type": "string", "minLength": 1 },
        "scopus":        { "type": "string", "minLength": 1 },
        "wos":           { "type": "string", "minLength": 1 },
        "photo":         { "type": "string", "minLength": 1 },
        "photo_height":  { "type": "string", "minLength": 1 },
        "photo_frame":   { "type": "string", "minLength": 1 },
        "bio":           { "type": "string", "minLength": 1 }
      }
    },
    "experience": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/experience" }
    },
    "awards": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/award" }
    },
    "education": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/education" }
    },
    "research": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/research" }
    },
    "projects": {
      "type": "object",
      "required": ["european", "national"],
      "additionalProperties": false,
      "properties": {
        "european": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } },
        "national":  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } }
      }
    },
    "conferences": {
      "type": "object",
      "required": ["chairs", "committee", "talks"],
      "additionalProperties": false,
      "properties": {
        "chairs":    { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conference/chair" } },
        "committee": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conference/committee" } },
        "talks": {
          "type": "object",
          "required": ["invited", "regular"],
          "additionalProperties": false,
          "properties": {
            "invited": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conference/talk" } },
            "regular": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conference/regular" } }
          }
        }
      }
    },
    "software": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/software" }
    },
    "editorial": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/editorial" }
    },
    "review": {
      "type": "object",
      "required": ["projects", "journals"],
      "additionalProperties": false,
      "properties": {
        "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/review/project" } },
        "journals":  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/review/journal" } }
      }
    },
    "teaching": {
      "type": "object",
      "required": ["courses", "masters", "schools", "mentorships"],
      "additionalProperties": false,
      "properties": {
        "courses":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teaching/course" } },
        "masters":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teaching/masters" } },
        "schools":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teaching/program" } },
        "mentorships": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teaching/mentorship" } }
      }
    }
  },
  "$defs": {
    "date":  { "type": ["string", "integer"] },
    "module": {
      "type": "object",
      "required": ["name", "duration"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 }
      }
    },
    "dated": {
      "anyOf": [
        { "required": ["year"] },
        { "required": ["start"] }
      ]
    },
    "experience": {
      "type": "object",
      "required": ["title", "org"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "title":       { "type": "string", "minLength": 1 },
        "org":         { "type": "string", "minLength": 1 },
        "location":    { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "award": {
      "type": "object",
      "required": ["title", "org", "description"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "title":       { "type": "string", "minLength": 1 },
        "org":         { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "education": {
      "type": "object",
      "required": ["start", "end", "title", "org", "grade"],
      "additionalProperties": false,
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "title":       { "type": "string", "minLength": 1 },
        "org":         { "type": "string", "minLength": 1 },
        "grade":       { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "research": {
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "title":       { "type": "string", "minLength": 1 },
        "org":         { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "required": ["role", "acronym", "name", "funding"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "role":        { "type": "string", "minLength": 1 },
        "acronym":     { "type": "string", "minLength": 1 },
        "name":        { "type": "string", "minLength": 1 },
        "funding":     { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "achievement": { "type": "string", "minLength": 1 }
      }
    },
    "software": {
      "type": "object",
      "required": ["title", "role", "description"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":        { "$ref": "#/$defs/date" },
        "start":       { "$ref": "#/$defs/date" },
        "end":         { "$ref": "#/$defs/date" },
        "title":       { "type": "string", "minLength": 1 },
        "role":        { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "website":     { "type": "string", "minLength": 1 },
        "github":      { "type": "string", "minLength": 1 },
        "citation":    { "type": "string", "minLength": 1 },
        "package":     { "type": "string", "minLength": 1 }
      }
    },
    "editorial": {
      "type": "object",
      "required": ["role", "journal", "publisher"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/dated" }],
      "properties": {
        "year":      { "$ref": "#/$defs/date" },
        "start":     { "$ref": "#/$defs/date" },
        "end":       { "$ref": "#/$defs/date" },
        "role":      { "type": "string", "minLength": 1 },
        "journal":   { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "issue":     { "type": "string", "minLength": 1 }
      }
    },
    "conference": {
      "chair": {
        "type": "object",
        "required": ["role", "acronym", "name", "location"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":        { "$ref": "#/$defs/date" },
          "start":       { "$ref": "#/$defs/date" },
          "end":         { "$ref": "#/$defs/date" },
          "role":        { "type": "string", "minLength": 1 },
          "acronym":     { "type": "string", "minLength": 1 },
          "name":        { "type": "string", "minLength": 1 },
          "location":    { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      },
      "committee": {
        "type": "object",
        "required": ["years", "acronym", "name"],
        "additionalProperties": false,
        "properties": {
          "years":   { "type": "array", "minItems": 1, "items": { "type": "integer" } },
          "acronym": { "type": "string", "minLength": 1 },
          "name":    { "type": "string", "minLength": 1 }
        }
      },
      "talk": {
        "type": "object",
        "required": ["role", "name", "location"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":     { "$ref": "#/$defs/date" },
          "start":    { "$ref": "#/$defs/date" },
          "end":      { "$ref": "#/$defs/date" },
          "role":     { "type": "string", "minLength": 1 },
          "acronym":  { "type": "string", "minLength": 1 },
          "name":     { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "author":   { "type": "string", "minLength": 1 },
          "abstract": { "type": "string", "minLength": 1 },
          "url":      { "type": "string", "minLength": 1 }
        }
      },
      "regular": {
        "type": "object",
        "required": ["name", "location"],
        "additionalProperties": false,
        "properties": {
          "name":     { "type": "string", "minLength": 1 },
          "acronym":  { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "author":   { "type": "string", "minLength": 1 },
          "abstract": { "type": "string", "minLength": 1 },
          "url":      { "type": "string", "minLength": 1 }
        }
      }
    },
    "review": {
      "project": {
        "type": "object",
        "required": ["title", "description"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":        { "$ref": "#/$defs/date" },
          "start":       { "$ref": "#/$defs/date" },
          "end":         { "$ref": "#/$defs/date" },
          "title":       { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      },
      "journal": {
        "type": "object",
        "required": ["title", "issn"],
        "additionalProperties": false,
        "properties": {
          "title":  { "type": "string", "minLength": 1 },
          "editor": { "type": "string", "minLength": 1 },
          "issn":   { "type": "string", "minLength": 1, "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$" }
        }
      }
    },
    "teaching": {
      "course": {
        "type": "object",
        "required": ["role", "course", "institution", "kind"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":        { "$ref": "#/$defs/date" },
          "start":       { "$ref": "#/$defs/date" },
          "end":         { "$ref": "#/$defs/date" },
          "role":        { "type": "string", "minLength": 1 },
          "course":      { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "kind":        { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "duration":    { "type": "string", "minLength": 1 },
          "modules":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
        }
      },
      "masters": {
        "type": "object",
        "required": ["years", "role", "program", "institution"],
        "additionalProperties": false,
        "properties": {
          "years": {
            "oneOf": [
              { "type": "array", "minItems": 1, "items": { "type": "integer" } },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "role":        { "type": "string", "minLength": 1 },
          "program":     { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "duration":    { "type": "string", "minLength": 1 },
          "modules":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
        }
      },
      "program": {
        "type": "object",
        "required": ["role", "program", "institution"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":        { "$ref": "#/$defs/date" },
          "start":       { "$ref": "#/$defs/date" },
          "end":         { "$ref": "#/$defs/date" },
          "role":        { "type": "string", "minLength": 1 },
          "program":     { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "duration":    { "type": "string", "minLength": 1 },
          "modules":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
        }
      },
      "mentorship": {
        "type": "object",
        "required": ["role", "kind", "topic", "institution", "student"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/$defs/dated" }],
        "properties": {
          "year":        { "$ref": "#/$defs/date" },
          "start":       { "$ref": "#/$defs/date" },
          "end":         { "$ref": "#/$defs/date" },
          "role":        { "type": "string", "minLength": 1 },
          "kind":        { "type": "string", "minLength": 1 },
          "topic":       { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "student":     { "type": "string", "minLength": 1 },
          "abstract":    { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
